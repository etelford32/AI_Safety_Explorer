# Copy to .env and fill in. Never commit .env.
# Only the provider you actually use needs a key.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# For a local OpenAI-compatible endpoint (llama.cpp, vLLM, Ollama).
# A local model with pinned weights cannot silently change under you, which makes it
# the control condition for the drift question (RQ8).
# OPENAI_BASE_URL=http://localhost:11434/v1
